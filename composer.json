{
    "name": "laravel/livewire-starter-kit",
    "description": "The unofficial Laravel starter kit for Livewire with some tools included.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "laravel",
        "framework",
        "livewire",
        "flux"
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "livewire/flux": "^2.1.1",
        "livewire/volt": "^1.7.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "ergebnis/composer-normalize": "^2.45",
        "fakerphp/faker": "^1.23",
        "graham-campbell/analyzer": "^5.0",
        "larastan/larastan": "^3.1",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1",
        "pestphp/pest-plugin-type-coverage": "^3.2",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "composer normalize"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyze": [
            "vendor/bin/phpstan analyse --memory-limit=2G --ansi"
        ],
        "checks": [
            "@refactor",
            "@lint",
            "@analyze",
            "@test"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "lint": [
            "vendor/bin/pint"
        ],
        "refactor": [
            "vendor/bin/rector process --config=rector.php"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest --bail --parallel --order-by=random --coverage"
        ],
        "test:mutate": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest --mutate --parallel --everything --covered-only"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
